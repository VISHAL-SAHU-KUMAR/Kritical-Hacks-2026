# Server
PORT=3001
FRONTEND_URL=http://localhost:3001
NODE_ENV=development
DATA_DIR=./data
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://dueshield:local-development-only@localhost:5432/dueshield
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_DAYS=7

# Optional integrations. Features stay clearly in fallback/unconfigured mode if unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TINYFISH_API_KEY=
# Set only after verifying the current official TinyFish API contract.
TINYFISH_BASE_URL=
